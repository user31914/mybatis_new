<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhit.mapper.StudentMapper">
    <insert id="insert" parameterType="com.hhit.model.Student">
        insert into student values(null,#{name},#{age},#{gender})
    </insert>
    <update id="update" parameterType="com.hhit.model.Student">
        update student set name = #{name},age = #{age},gender= #{gender} where id = #{id}
    </update>
    <delete id="delete" parameterType="int">
        delete from student where id = #{id}
    </delete>
    <select id="selectById" parameterType="int" resultType="com.hhit.model.Student">
        select *from student where id = #{id}
    </select>
    <select id="selectList" resultType="com.hhit.model.Student">
        select  *from student
    </select>
</mapper>