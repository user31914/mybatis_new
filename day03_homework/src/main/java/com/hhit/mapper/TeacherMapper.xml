<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhit.mapper.TeacherMapper">
    <insert id="insert" parameterType="Teacher">
        insert into teacher values(default,#{name},#{addr},#{age},#{job},#{sal})
    </insert>
    <select id="selectByAddr" parameterType="String" resultType="Teacher">
        select * from teacher where addr like #{addr}"%"
    </select>
    <select id="calAvgSal" resultType="decimal" parameterType="string">
        select avg(sal) from teacher where addr like #{addr}"%"
    </select>
    <update id="updateJob" parameterType="Teacher">
        update teacher set job = '销售经理' where age>= #{age} and job = #{job}
    </update>
    <delete id="deleteByAge" parameterType="int">
        delete
        from teacher
        where age >= 35
    </delete>
</mapper>