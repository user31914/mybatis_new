<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhit.mapper.UsersMapper">
    <resultMap id="userLogin" type="Users" autoMapping="true">
        <id property="uid" column="uid"></id>
        <collection property="roles" ofType="Role" autoMapping="true">
            <id property="rid" column="rid"></id>
            <collection property="permissions" ofType="Permision" autoMapping="true">
                <id  property="pid" column="pid"></id>
            </collection>
        </collection>
    </resultMap>
    <select id="login" resultMap="userLogin">
        select urr.uid, urr.uname, urr.pwd, urr.rname, urr.rid, p.pid, p.pname, p.url
        from (select u.uid, u.uname, u.pwd, r.rname, r.rid
              from users u,
                   role r,
                   users_role ur
              where u.uid = ur.uid
                and r.rid = ur.rid) urr,
             permision p,
             role_permision rp
        where urr.rid = rp.rid
          and p.pid = rp.pid
          and urr.uname = #{uname}
          and urr.pwd = #{pwd}
    </select>

    <update id="update" parameterType="Users">
        update users
        <set>
            <if test="lasttime!=null">
                lasttime = #{lasttime}
            </if>
        </set>
        where uname = #{uname}
    </update>

</mapper>